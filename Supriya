  .hero h1{font-size:52px;line-height:1.1}
  .hero h1 span{background:#ffdb58;padding:0 10px}
  .tag{background:#fff;border:1px solid #111;border-radius:20px;padding:6px 12px;display:inline-block;margin:8px 6px 0 0;font-size:14px}
  .card{background:#fff;border:1.5px solid #111;border-radius:18px;padding:24px;margin-top:24px;box-shadow:6px 6px 0 #111}
  .grid2{display:grid;grid-template-columns:1fr 1fr;gap:20px}
  .grid3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px}
  .skill-bar{background:#eee;height:8px;border-radius:10px;margin-top:8px}
  .skill-fill{height:8px;background:#111;border-radius:10px}
  footer{text-align:center;padding:40px 0;color:#666}
